// Barre latérale de navigation. Change AppState.page, rien d'autre.
import { Theme, Icons } from "../theme.slint";
import { Icon, SectionLabel, Badge, Button, ButtonVariant } from "primitives.slint";
import { Page } from "../types.slint";
import { AppState, StudioState, SearchState, IndexState } from "../state.slint";

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <string> badge;          // ex. "Bientôt", "3"
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.surface : (touch.has-hover && enabled ? Theme.surface.transparentize(40%) : transparent);
    border-width: active ? 1px : 0px;
    border-color: Theme.border;
    opacity: enabled ? 1 : 0.55;

    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: icon;
            tint: active ? Theme.accent : Theme.ink-muted;
        }
        Text {
            horizontal-stretch: 1;
            text: label;
            color: Theme.ink;
            font-family: Theme.font-sans;
            font-size: Theme.fs-body;
            font-weight: active ? 500 : 400;
            vertical-alignment: center;
        }
        if badge != "": Badge {
            y: (parent.height - self.height) / 2;
            text: badge;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component SideBar inherits Rectangle {
    width: Theme.sidebar-width;
    background: Theme.surface-2;

    // Bord droit
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: Theme.space-2;
        padding-top: Theme.space-3;
        spacing: 2px;

        Button {
            text: "Ouvrir un fichier";
            icon: Icons.upload;
            variant: ButtonVariant.primary;
            clicked => { AppState.open-file-dialog(); }
        }
        Rectangle { height: Theme.space-3; }

        NavItem {
            icon: Icons.home;
            label: "Accueil";
            active: AppState.page == Page.home;
            clicked => { AppState.page = Page.home; }
        }
        NavItem {
            icon: Icons.table;
            label: "Data Studio";
            badge: StudioState.tabs.length > 0 ? "\{StudioState.tabs.length}" : "";
            active: AppState.page == Page.studio;
            clicked => { AppState.page = Page.studio; }
        }
        NavItem {
            icon: Icons.search;
            label: "Recherche";
            active: AppState.page == Page.search;
            clicked => { AppState.page = Page.search; }
        }

        Rectangle { height: Theme.space-3; }
        SectionLabel { text: "À VENIR"; height: 24px; vertical-alignment: center; x: Theme.space-2; }
        NavItem {
            icon: Icons.diff;
            label: "Comparer";
            badge: "Bientôt";
            enabled: false;
        }
        NavItem {
            icon: Icons.spark;
            label: "Agent local";
            badge: "Bientôt";
            active: AppState.page == Page.agent;
            clicked => { AppState.page = Page.agent; }
        }

        Rectangle { height: Theme.space-3; }
        SectionLabel { text: "DOSSIERS INDEXÉS"; height: 24px; vertical-alignment: center; x: Theme.space-2; }
        for folder[i] in IndexState.folders: NavItem {
            icon: Icons.folder;
            label: folder.name;
            badge: folder.files;
            clicked => { IndexState.folder-clicked(i); }
        }
        NavItem {
            icon: Icons.plus;
            label: "Ajouter un dossier";
            enabled: !IndexState.indexing;
            clicked => { IndexState.add-folder(); }
        }

        Rectangle { vertical-stretch: 1; }

        // Statut de l'index de recherche
        if SearchState.index-text != "": HorizontalLayout {
            padding-left: Theme.space-2;
            spacing: 6px;
            height: 24px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 7px; height: 7px;
                border-radius: 4px;
                background: IndexState.indexing ? Theme.warn : Theme.accent;
            }
            Text {
                text: SearchState.index-text;
                color: Theme.ink-muted;
                font-family: Theme.font-sans;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        NavItem {
            icon: Icons.settings;
            label: "Paramètres";
            active: AppState.page == Page.settings;
            clicked => { AppState.page = Page.settings; }
        }
    }
}
