// Éditeur SQL : zone multiligne mono + bouton Exécuter (Ctrl+Entrée).
// Pas de coloration syntaxique (Slint n'en fournit pas) : texte mono sur fond bg.
import { Theme, Icons } from "../theme.slint";
import { Button, ButtonVariant, Icon } from "primitives.slint";

export component SqlEditor inherits Rectangle {
    in-out property <string> query;
    in property <bool> running: false;
    in property <string> error;
    in property <string> info;
    callback run(sql: string);

    public function focus-input() { input.focus(); }

    background: Theme.surface;

    VerticalLayout {
        padding: Theme.space-3;
        padding-left: Theme.space-4;
        padding-right: Theme.space-4;
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-3;
            // Zone de saisie
            Rectangle {
                horizontal-stretch: 1;
                min-height: 76px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: error != "" ? Theme.danger : (input.has-focus ? Theme.accent : Theme.border);
                background: Theme.bg;
                clip: true;

                input := TextInput {
                    x: Theme.space-3;
                    y: Theme.space-2;
                    width: parent.width - 2 * Theme.space-3;
                    height: parent.height - 2 * Theme.space-2;
                    text <=> root.query;
                    single-line: false;
                    wrap: no-wrap;
                    color: Theme.ink;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-small;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.ink;
                    key-pressed(event) => {
                        if (event.modifiers.control && event.text == "\n") {
                            root.run(root.query);
                            return accept;
                        }
                        reject
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 0;
                spacing: Theme.space-2;
                alignment: start;
                Button {
                    width: self.min-width;
                    text: running ? "Exécution…" : "Exécuter";
                    icon: Icons.play;
                    shortcut: "Ctrl ↵";
                    variant: ButtonVariant.primary;
                    enabled: !running;
                    clicked => { root.run(root.query); }
                }
            }
        }

        // Ligne d'état de la requête
        if error != "" || info != "": HorizontalLayout {
            spacing: 6px;
            height: 16px;
            Icon {
                y: (parent.height - self.height) / 2;
                size: 14px;
                data: error != "" ? Icons.alert : Icons.check;
                tint: error != "" ? Theme.danger : Theme.accent;
            }
            Text {
                horizontal-stretch: 1;
                text: error != "" ? error : info;
                color: error != "" ? Theme.danger : Theme.ink-muted;
                font-family: error != "" ? Theme.font-mono : Theme.font-sans;
                font-size: Theme.fs-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}
