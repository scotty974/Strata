// Jetons de design de Strata : couleurs (clair / sombre), typo, espacements, rayons.
// Toute couleur ou taille de l'interface doit venir d'ici.
import { Palette } from "std-widgets.slint";

export global Theme {
    // Suit le thème du système. Peut être forcé depuis Rust : Theme.set_dark(true).
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Fonds
    out property <color> bg:            dark ? #0e0e10 : #f6f6f4;   // fenêtre
    out property <color> surface:       dark ? #161619 : #ffffff;   // panneaux de travail
    out property <color> surface-2:     dark ? #1e1e22 : #efefec;   // sidebar, en-têtes, survol
    out property <color> border:        dark ? #2a2a2f : #e3e3df;   // traits 1px
    out property <color> border-strong: dark ? #6c6c75 : #8e8e94;   // contours de contrôles (3:1)

    // Texte
    out property <color> ink:           dark ? #ededef : #18181b;
    out property <color> ink-muted:     dark ? #9b9ba4 : #64646b;

    // Accent unique
    out property <color> accent:        dark ? #3cc9a6 : #0b7a64;
    out property <color> accent-ink:    dark ? #06231c : #ffffff;
    out property <color> accent-soft:   dark ? #123029 : #e2f2ed;
    out property <color> accent-text:   dark ? #5fdcbc : #085e4d;

    // Familles de fichiers (icônes et pastilles uniquement)
    out property <color> ft-doc:        dark ? #6b9bff : #2563eb;
    out property <color> ft-pdf:        dark ? #f87171 : #dc2626;
    out property <color> ft-data:       dark ? #f5a524 : #c2690a;
    out property <color> ft-code:       dark ? #a78bfa : #7c3aed;
    out property <color> ft-image:      dark ? #38bdf8 : #0891b2;

    // États
    out property <color> warn:          dark ? #f5b041 : #a15c00;
    out property <color> warn-soft:     dark ? #2e2412 : #fdf3e1;
    out property <color> danger:        dark ? #f87171 : #c02626;
    out property <color> close-hover:   #c42b1c;

    // Typo
    out property <string> font-sans: "Inter";
    out property <string> font-mono: "JetBrains Mono";
    out property <length> fs-display: 28px;
    out property <length> fs-title: 18px;
    out property <length> fs-heading: 14px;
    out property <length> fs-body: 13px;
    out property <length> fs-small: 12px;
    out property <length> fs-label: 11px;

    // Espacements (grille de 4px)
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-6: 24px;
    out property <length> space-8: 32px;

    // Rayons
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-full: 999px;

    // Dimensions récurrentes
    out property <length> titlebar-height: 44px;
    out property <length> sidebar-width: 216px;
    out property <length> control-height: 30px;
    out property <length> row-height: 30px;
}

