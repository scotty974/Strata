// Formatage d'affichage (purement visuel)
export global Format {
    pure function pad3(n: int) -> string {
        return n < 10 ? "00\{n}" : n < 100 ? "0\{n}" : "\{n}";
    }
    // 1284302 -> "1 284 302"
    public pure function thousands(n: int) -> string {
        if (n < 1000) { return "\{n}"; }
        if (n < 1000000) { return "\{floor(n / 1000)} \{pad3(mod(n, 1000))}"; }
        if (n < 1000000000) { return "\{floor(n / 1000000)} \{pad3(mod(floor(n / 1000), 1000))} \{pad3(mod(n, 1000))}"; }
        return "\{floor(n / 1000000000)} \{pad3(mod(floor(n / 1000000), 1000))} \{pad3(mod(floor(n / 1000), 1000))} \{pad3(mod(n, 1000))}";
    }
}
